# SpeakPay mobile (Expo) — copy to .env and fill. NEVER commit real values.
# Every EXPO_PUBLIC_* value is compiled into the APK: put NO secrets here.
# EAS cloud builds do not read .env — set these with `eas env:create` (ENVIRONMENT.md §2.11).

EXPO_PUBLIC_API_BASE_URL=https://speakpay.vercel.app
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_POLICY_VAULT_PROGRAM_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_IDENTITY_NAME=SpeakPay
EXPO_PUBLIC_APP_IDENTITY_URI=https://speakpay.vercel.app
# Public merchant address used to prefill the demo allowlist (same value as MERCHANT_CLEAN_WALLET on the web app)
EXPO_PUBLIC_MERCHANT_CLEAN_WALLET=
