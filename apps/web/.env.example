# SpeakPay web (Next.js) — copy to .env.local and fill. NEVER commit real values.
# See ENVIRONMENT.md §1.2 / §2 for how to obtain each value.

# ---------- PUBLIC (shipped to the browser) ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_POLICY_VAULT_PROGRAM_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- SERVER ONLY (secrets: never prefix with NEXT_PUBLIC_) ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
# One-line JSON array of 64 numbers from agent-delegate.json (jq -c .)
AGENT_DELEGATE_SECRET_KEY=
MERCHANT_CLEAN_WALLET=
MERCHANT_SHADY_ATTACKER_WALLET=

FIRECRAWL_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_STT_MODEL_ID=scribe_v3
ELEVENLABS_TTS_MODEL_ID=eleven_flash_v2_5

SUPABASE_SERVICE_ROLE_KEY=

ROGUE_SIM_ENABLED=true

# Optional LLM fallback for intent parsing (transcript only, never web content)
INTENT_LLM_ENABLED=false
INTENT_LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
